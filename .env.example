# 0G Hack Guard — Environment Variables
# Copy this file to .env and fill in your credentials.

# ---------------------------------------------------------------------------
# X (Twitter) API v2 — OAuth 1.0a User Context
# ---------------------------------------------------------------------------
# Required for posting tweets and threads.
# Get these from https://developer.x.com/en/portal/dashboard
#   1. Create a Project + App
#   2. Generate "User authentication tokens" (OAuth 1.0a)
#   3. Copy Consumer Key / Secret and Access Token / Secret below.
X_CONSUMER_KEY=your_consumer_key_here
X_CONSUMER_SECRET=your_consumer_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# ---------------------------------------------------------------------------
# Telegram Bot (optional — for threat intel broadcasts)
# ---------------------------------------------------------------------------
# Get a bot token from @BotFather on Telegram.
# Get your chat ID by messaging @userinfobot or adding bot to a group.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_BOT_USERNAME=your_bot_username_without_at
TELEGRAM_REGISTRATION_SECRET=generate_a_long_random_secret
TELEGRAM_WEBHOOK_SECRET_TOKEN=generate_a_long_random_webhook_secret
# Defaults to content/telegram_opt_ins.local.json when unset.
TELEGRAM_OPT_IN_STORE_PATH=

# ---------------------------------------------------------------------------
# 0G Chain (optional — used by other CLI commands)
# ---------------------------------------------------------------------------
ZGG_CHAIN_RPC=https://evmrpc.0g.ai
ZGG_CHAIN_ID=16661
ZGG_RECEIPT_CONTRACT=0xBaC59b1571b7c7195915c5B36D8A719Ed7182abc
